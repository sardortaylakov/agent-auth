# Auth0 Configuration
# Get these from: https://manage.auth0.com → Applications → Your App → Settings
APP_BASE_URL=http://localhost:3000
AUTH0_SECRET=                        # Run: openssl rand -hex 32
AUTH0_DOMAIN=                        # e.g. your-tenant.us.auth0.com
AUTH0_CLIENT_ID=                     # From Auth0 dashboard
AUTH0_CLIENT_SECRET=                 # From Auth0 dashboard
AUTH0_AUDIENCE=                      # e.g. https://agent-auth-api

# OpenAI
OPENAI_API_KEY=                      # From https://platform.openai.com/api-keys

# Auth0 Token Vault (for Gmail/Google Calendar OAuth)
# Set up: Auth0 Dashboard → Auth → Social Connections → Google
# Enable Token Vault grant in: Applications → Your App → Settings → Advanced → Grant Types
AUTH0_CONNECTION=google-oauth2
